<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wsr2.Engine\Wsr2.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Make the repo's tuning.json available next to the test assembly so
         TuningLoader.DefaultTuningPath() can find it during test runs. -->
    <None Include="..\..\..\tuning.json" Link="tuning.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
