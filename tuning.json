{
  "$schema": "./tuning.schema.json",
  "time": {
    "ticksPerYear": 252,
    "defaultCareerYears": 30,
    "maxSimYears": 50,
    "tickIntervalMsAt1x": 1000
  },
  "macro": {
    "initial": {
      "cyclePhase": "Expansion",
      "gdpGrowth": 0.025,
      "inflation": 0.022,
      "policyRate": 0.03,
      "creditSpread": 0.012,
      "consumerSentiment": 0.55
    },
    "cycle": {
      "phaseOrder": ["Expansion", "Peak", "Contraction", "Trough"],
      "minTicksPerPhase": {
        "Expansion": 504,
        "Peak": 63,
        "Contraction": 189,
        "Trough": 63
      },
      "maxTicksPerPhase": {
        "Expansion": 1764,
        "Peak": 252,
        "Contraction": 504,
        "Trough": 189
      }
    },
    "drift": {
      "gdpGrowth":         { "mean": 0.025, "reversion": 0.0040, "vol": 0.0009, "min": -0.06,  "max":  0.07 },
      "inflation":         { "mean": 0.022, "reversion": 0.0030, "vol": 0.0007, "min": -0.02,  "max":  0.10 },
      "policyRate":        { "mean": 0.03,  "reversion": 0.0020, "vol": 0.0005, "min":  0.0,   "max":  0.12 },
      "creditSpread":      { "mean": 0.012, "reversion": 0.0050, "vol": 0.0006, "min":  0.001, "max":  0.08 },
      "consumerSentiment": { "mean": 0.55,  "reversion": 0.0060, "vol": 0.0040, "min":  0.05,  "max":  0.95 }
    },
    "phaseBias": {
      "Expansion":   { "gdpGrowth":  0.00010, "inflation":  0.00003, "policyRate":  0.00002, "creditSpread": -0.00002, "consumerSentiment":  0.00020 },
      "Peak":        { "gdpGrowth":  0.00000, "inflation":  0.00010, "policyRate":  0.00010, "creditSpread":  0.00000, "consumerSentiment":  0.00005 },
      "Contraction": { "gdpGrowth": -0.00040, "inflation": -0.00005, "policyRate": -0.00005, "creditSpread":  0.00020, "consumerSentiment": -0.00060 },
      "Trough":      { "gdpGrowth": -0.00005, "inflation": -0.00010, "policyRate": -0.00010, "creditSpread":  0.00005, "consumerSentiment": -0.00010 }
    }
  },
  "multiplayer": {
    "maxPlayersPerSession": 8,
    "speedPolicy": {
      "soloPlayerControlsSpeed": true,
      "multiplayerLockedTo1x": true,
      "allowedSpeedsSolo": [0, 1, 4, 16, 64]
    },
    "snapshotEveryTicks": 252,
    "orderQueueDeterministicTiebreak": "playerIdAscending"
  },
  "leaderboard": {
    "publicByDefault": true,
    "fields": ["playerId", "displayName", "totalAum", "returnPct", "rank"]
  },
  "feedback": {
    "playerWealthEffect": {
      "enabledFromDay1": true,
      "aumShareToFlowGain": 0.5,
      "flowContributionCap": 0.05,
      "priceImpactBpsPerAdvPct": 8,
      "priceImpactCapBps": 150
    }
  },
  "stability": {
    "dailyMoveCapPct": 25,
    "eventDayDailyMoveCapPct": 60,
    "sectorTickShockBudgetPct": 15,
    "marketTickShockBudgetPct": 8
  },
  "breakthroughs": {
    "perCompanyAnnualProbability": 0.02,
    "severityDistribution": { "type": "truncatedPareto", "alpha": 1.5, "min": 0.1, "max": 1.0 },
    "decay": { "defaultHalfLifeTicks": 60 },
    "adminInjectEnabled": true,
    "seededRandomEnabled": true,
    "archetypes": [
      { "id": "BreakthroughInvention",      "direction":  1, "minPct":  20, "maxPct":  60, "rippleCompetitorsPct":  -10, "rippleSuppliersPct":   5 },
      { "id": "EfficiencyGain",             "direction":  1, "minPct":  10, "maxPct":  30, "rippleCompetitorsPct":   -5, "rippleSuppliersPct":  -3 },
      { "id": "BlockbusterLaunch",          "direction":  1, "minPct":  15, "maxPct":  40, "rippleCompetitorsPct":   -8, "rippleSuppliersPct":   3 },
      { "id": "RegulatoryApproval",         "direction":  1, "minPct":  10, "maxPct":  25, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":   0 },
      { "id": "DisruptiveEntrant",          "direction":  1, "minPct":  30, "maxPct":  80, "rippleCompetitorsPct":  -15, "rippleSuppliersPct":   0 },
      { "id": "FraudScandal",               "direction": -1, "minPct":  30, "maxPct":  70, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":  -2 },
      { "id": "ProductRecall",              "direction": -1, "minPct":  15, "maxPct":  40, "rippleCompetitorsPct":    5, "rippleSuppliersPct":  -5 },
      { "id": "KeyPersonLoss",              "direction": -1, "minPct":   5, "maxPct":  20, "rippleCompetitorsPct":    1, "rippleSuppliersPct":   0 },
      { "id": "AntitrustRuling",            "direction": -1, "minPct":  10, "maxPct":  30, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":   0 },
      { "id": "ActivistTakeover",           "direction":  1, "minPct":  10, "maxPct":  25, "rippleCompetitorsPct":    2, "rippleSuppliersPct":   0 }
    ]
  },
  "visibility": {
    "roles": {
      "Admin": {
        "macro.gdpGrowth": true, "macro.inflation": true, "macro.policyRate": true,
        "macro.creditSpread": true, "macro.consumerSentiment": true, "macro.cyclePhase": true,
        "sector.earningsGrowth": true, "sector.rotationFactor": true, "sector.pe": true,
        "company.price": true, "company.volume": true, "company.ttmEarnings": true,
        "company.fairValue": true, "company.qualityScore": true,
        "company.floatHeldByPlayer": true, "company.playerImpactDecay": true,
        "player.ownPositions": true, "player.otherPositions": true,
        "leaderboard.basic": true, "leaderboard.detailed": true,
        "events.publicFeed": true, "events.internalRecord": true,
        "session.tickInternals": true, "session.rngCursor": true
      },
      "Standard": {
        "macro.gdpGrowth": true, "macro.inflation": true, "macro.policyRate": true,
        "macro.creditSpread": false, "macro.consumerSentiment": true, "macro.cyclePhase": false,
        "sector.earningsGrowth": true, "sector.rotationFactor": false, "sector.pe": true,
        "company.price": true, "company.volume": true, "company.ttmEarnings": true,
        "company.fairValue": false, "company.qualityScore": false,
        "company.floatHeldByPlayer": false, "company.playerImpactDecay": false,
        "player.ownPositions": true, "player.otherPositions": false,
        "leaderboard.basic": true, "leaderboard.detailed": false,
        "events.publicFeed": true, "events.internalRecord": false,
        "session.tickInternals": false, "session.rngCursor": false
      }
    }
  }
}
