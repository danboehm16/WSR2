{
  "$schema": "./tuning.schema.json",
  "time": {
    "ticksPerYear": 252,
    "defaultCareerYears": 30,
    "maxSimYears": 50,
    "tickIntervalMsAt1x": 1000
  },
  "macro": {
    "initial": {
      "cyclePhase": "Up",
      "marketMood": 0.55
    },
    "cycle": {
      "phaseOrder": ["Up", "Down"],
      "minTicksPerPhase": { "Up": 504, "Down": 189 },
      "maxTicksPerPhase": { "Up": 1764, "Down": 504 }
    },
    "drift": {
      "marketMood": { "mean": 0.55, "reversion": 0.0060, "vol": 0.0040, "min": 0.05, "max": 0.95 }
    },
    "phaseBias": {
      "Up":   { "marketMood":  0.00020 },
      "Down": { "marketMood": -0.00060 }
    }
  },
  "multiplayer": {
    "maxPlayersPerSession": 8,
    "speedPolicy": {
      "soloPlayerControlsSpeed": true,
      "multiplayerLockedTo1x": true,
      "allowedSpeedsSolo": [0, 1, 4, 16, 64]
    },
    "snapshotEveryTicks": 252,
    "orderQueueDeterministicTiebreak": "playerIdAscending"
  },
  "leaderboard": {
    "publicByDefault": true,
    "fields": ["playerId", "displayName", "totalAum", "returnPct", "rank"]
  },
  "impact": {
    "enabledFromDay1": true,
    "impactGain": 0.01,
    "whaleBonusGain": 5.0,
    "whaleBonusCap": 0.50,
    "impactCapBps": 150,
    "baseAdvFraction": 0.002
  },
  "stability": {
    "dailyMoveCapPct": 25,
    "eventDayDailyMoveCapPct": 60
  },
  "breakthroughs": {
    "perCompanyAnnualProbability": 0.02,
    "severityTiers": [
      { "name": "small",  "probability": 0.70, "severityMin": 0.10, "severityMax": 0.25 },
      { "name": "medium", "probability": 0.25, "severityMin": 0.25, "severityMax": 0.50 },
      { "name": "huge",   "probability": 0.05, "severityMin": 0.50, "severityMax": 0.80 }
    ],
    "decay": { "defaultHalfLifeTicks": 60 },
    "adminInjectEnabled": true,
    "seededRandomEnabled": true,
    "archetypes": [
      { "id": "BreakthroughInvention",      "direction":  1, "minPct":  20, "maxPct":  60, "rippleCompetitorsPct":  -10, "rippleSuppliersPct":   5 },
      { "id": "EfficiencyGain",             "direction":  1, "minPct":  10, "maxPct":  30, "rippleCompetitorsPct":   -5, "rippleSuppliersPct":  -3 },
      { "id": "BlockbusterLaunch",          "direction":  1, "minPct":  15, "maxPct":  40, "rippleCompetitorsPct":   -8, "rippleSuppliersPct":   3 },
      { "id": "RegulatoryApproval",         "direction":  1, "minPct":  10, "maxPct":  25, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":   0 },
      { "id": "DisruptiveEntrant",          "direction":  1, "minPct":  30, "maxPct":  80, "rippleCompetitorsPct":  -15, "rippleSuppliersPct":   0 },
      { "id": "FraudScandal",               "direction": -1, "minPct":  30, "maxPct":  70, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":  -2 },
      { "id": "ProductRecall",              "direction": -1, "minPct":  15, "maxPct":  40, "rippleCompetitorsPct":    5, "rippleSuppliersPct":  -5 },
      { "id": "KeyPersonLoss",              "direction": -1, "minPct":   5, "maxPct":  20, "rippleCompetitorsPct":    1, "rippleSuppliersPct":   0 },
      { "id": "AntitrustRuling",            "direction": -1, "minPct":  10, "maxPct":  30, "rippleCompetitorsPct":   -3, "rippleSuppliersPct":   0 },
      { "id": "ActivistTakeover",           "direction":  1, "minPct":  10, "maxPct":  25, "rippleCompetitorsPct":    2, "rippleSuppliersPct":   0 }
    ]
  },
  "visibility": {
    "roles": {
      "Admin": {
        "macro.marketMood": true, "macro.cyclePhase": true,
        "sector.scalar": true,
        "company.price": true, "company.volume": true, "company.sharesOutstanding": true,
        "company.baseFairValue": true, "company.fairValue": true,
        "player.ownPositions": true, "player.otherPositions": true,
        "leaderboard.basic": true, "leaderboard.detailed": true,
        "events.publicFeed": true, "events.internalRecord": true,
        "session.tickInternals": true, "session.rngCursor": true
      },
      "Standard": {
        "macro.marketMood": true, "macro.cyclePhase": true,
        "sector.scalar": true,
        "company.price": true, "company.volume": true, "company.sharesOutstanding": true,
        "company.baseFairValue": false, "company.fairValue": false,
        "player.ownPositions": true, "player.otherPositions": false,
        "leaderboard.basic": true, "leaderboard.detailed": false,
        "events.publicFeed": true, "events.internalRecord": false,
        "session.tickInternals": false, "session.rngCursor": false
      }
    }
  }
}
